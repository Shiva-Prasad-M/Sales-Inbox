# Alumnx Sales Inbox - Environment Configuration
# Copy this file to `.env` and fill in your real values. Never commit `.env`.

# PostgreSQL / Supabase connection string
# For Supabase, use the Transaction Pooler (port 6543) connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dbname

# Google Gemini API key (used as the semantic enrichment layer)
GEMINI_API_KEY=your_gemini_api_key_here

# Candidate identifier (the owner of this inbox)
CANDIDATE_ID=medashivaprasad123@gmail.com

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173
